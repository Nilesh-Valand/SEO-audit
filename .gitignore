# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.env

# SQLite database — do NOT commit the .db file; the /app/db folder is kept via .gitkeep
backend/app/db/*.db
backend/app/db/*.db-shm
backend/app/db/*.db-wal
backend/app/db/snapshots/

# Crawl HTML snapshots (sibling of app/; keep folder via .gitkeep)
backend/data/*
!backend/data/snapshots/
backend/data/snapshots/*
!backend/data/snapshots/.gitkeep

# Legacy crawl snapshot location (repo root)
.crawl_data/

# Next.js web frontend
frontend-web/node_modules/
frontend-web/.next/
frontend-web/out/
frontend-web/.env.local
frontend-web/.env*.local

# Abandoned Next scaffold (do not commit)
web/
web/.next/
web/node_modules/

# Retired Chrome extension (removed; ignore if recreated locally)
extension/
extension/node_modules/
extension/dist/

# Logs / OS
*.log
.DS_Store
Thumbs.db
