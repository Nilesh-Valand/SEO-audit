ENV=development
DB_URL=sqlite:///./app/db/audit.db
# Comma-separated. After loading the extension, set:
# ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# (In ENV=development the API also reflects chrome-extension:// origins automatically.)
ALLOWED_ORIGINS=
CRAWLER_USER_AGENT=SEOAuditBot/0.1
CRAWLER_CONCURRENCY=5
CRAWLER_REQUEST_DELAY=0.5
CRAWLER_FLUSH_SIZE=25
CRAWLER_FLUSH_INTERVAL=3
CRAWLER_THIN_CONTENT_THRESHOLD=200
ENABLE_PAGESPEED=false
ENRICHMENT_PAGESPEED_SAMPLE_LIMIT=25
ENRICHMENT_PAGESPEED_BATCH_SIZE=2
ENRICHMENT_PAGESPEED_REQUEST_DELAY=1
ENRICHMENT_PAGESPEED_MAX_RETRIES=3
PAGESPEED_API_KEY=
